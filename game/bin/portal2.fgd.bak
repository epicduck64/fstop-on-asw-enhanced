	[
		0 : "Curious"
		1 : "Aggressive"
		2 : "Crazy"
		3 : "Richard"
		4 : "Aquarium"
		5 : "None"
	]	
	
	input StartTalking(void) : "Time to start talking."
	input Panic(void) : "Time to panic, we are back to the hub."
]

